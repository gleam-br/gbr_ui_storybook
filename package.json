{
  "name": "gbr_ui_storybook",
  "version": "1.0.1",
  "description": "Gleam UI lustre com o bundler vitejs e storybook.",
  "license": "Apache-2.0",
  "type": "module",
  "module": "./dist/index.js",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "author": {
    "name": "@gleam-br",
    "email": "contato@gleam.dev.br"
  },
  "keywords": [
    "storybook",
    "gleam",
    "lustre",
    "vite-plugin",
    "javascript"
  ],
  "homepage": "https://github.com/salespaulo/gbr_ui_storybook#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salespaulo/gbr_ui_storybook.git"
  },
  "bugs": {
    "url": "https://github.com/salespaulo/gbr_ui_storybook/issues"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@typescript/typescript6": "^6.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0",
    "vite-plugin-gleam": "^0.2.0"
  }
}